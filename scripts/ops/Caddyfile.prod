# Cloudflare terminates TLS for the proxied hosts, so Caddy must trust only
# Cloudflare's ranges when it derives the client IP. `trusted_proxies_strict`
# walks X-Forwarded-For from the right and stops at the first untrusted hop, so a
# spoofed header from a direct request (couple subdomains are DNS-only) is
# ignored and X-Real-IP below is always the real client.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
	}
}

# NOTE: /usr/bin/caddy is a custom xcaddy build
# (official deb ships no dns.providers modules). It carries a patch so the
# Hostinger DNS provider sends a TTL >= 60s for ACME challenge records, and the
# caddy package is apt-mark held. Rebuild: scripts/ops/build-caddy-linux.sh,
# deploy: scripts/ops/deploy-caddy.md. Do not `apt install --reinstall caddy`.

aksaraa.com, www.aksaraa.com {
	# The apex homepage is the Aksaraa design catalogue (wedding + Ceriavite in
	# one list). The rewrite must live here, not in Next's proxy: in the
	# standalone runtime `req.nextUrl.hostname` is the server's bind host
	# (localhost:3002), so a proxy host branch fires on every host and rewrites
	# `/` to an https:// upstream that Caddy serves as plain HTTP (EPROTO/500).
	# /landing still serves the old marketing page.
	@root path /
	rewrite @root /design

	reverse_proxy 127.0.0.1:3002 {
		header_up X-Real-IP {client_ip}
	}

	header / {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	encode gzip
}

education.aksaraa.com {
	reverse_proxy localhost:3000 {
		header_up X-Real-IP {client_ip}
	}

	header / {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	encode gzip
}

wp.aksaraa.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	root * /var/www/wp
	encode gzip
	php_fastcgi unix//run/php/php8.1-fpm.sock
	file_server
	try_files {path} {path}/ /index.php?{query}
}

# Ceriavite (kids: khitanan / aqiqah / ulang tahun). Marketing host only — the
# guest invitations stay on the couple wildcard below (`{slug}.aksaraa.com`), so
# there is no wildcard certificate and no couple rewrite here. Without this
# explicit block the `*.aksaraa.com` catch-all would treat "ceriavite" as a
# couple slug and 404 the landing page.
ceriavite.aksaraa.com {
	@root path /
	rewrite @root /ceriavite

	reverse_proxy 127.0.0.1:3002 {
		header_up X-Real-IP {client_ip}
	}

	encode gzip
}

*.aksaraa.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	@couple {
		header_regexp couple Host ^(?<slug>[a-zA-Z0-9-]+)\.aksaraa\.com$
		not host www.aksaraa.com
		not host wp.aksaraa.com
	}

	handle @couple {
		rewrite /scanner /scanner/{re.couple.slug}
		rewrite /scanner/ /scanner/{re.couple.slug}
		rewrite /led /led/{re.couple.slug}
		rewrite /led/ /led/{re.couple.slug}
		rewrite / /w/{re.couple.slug}

		@coupleCatchall not path / /api/* /_next/* /_static/* /fonts/* /templates/* /media/* /images/* /_vercel/* /favicon.ico /icon* /defaults/* /w/* /dashboard/* /qr/* /q/* /welcome/* /scanner/* /led/*
		rewrite @coupleCatchall /w/{re.couple.slug}{path}
		redir /templates/* https://cdn.aksaraa.com{uri} 302
		redir /fonts/* https://cdn.aksaraa.com{uri} 302
		redir /images/* https://cdn.aksaraa.com{uri} 302
	}

	reverse_proxy 127.0.0.1:3002 {
		header_up X-Real-IP {client_ip}
	}
}
wedding.aksaraa.com, *.wedding.aksaraa.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	@couple {
		header_regexp couple Host ^(?<slug>[a-zA-Z0-9-]+)\.wedding\.aksaraa\.com$
		not host wedding.aksaraa.com www.wedding.aksaraa.com
	}

	handle @couple {
		rewrite /scanner /scanner/{re.couple.slug}
		rewrite /scanner/ /scanner/{re.couple.slug}
		rewrite /led /led/{re.couple.slug}
		rewrite /led/ /led/{re.couple.slug}
		rewrite / /w/{re.couple.slug}

		@coupleCatchall not path / /api/* /_next/* /_static/* /fonts/* /templates/* /media/* /images/* /_vercel/* /favicon.ico /icon* /defaults/* /w/* /dashboard/* /qr/* /q/* /welcome/* /scanner/* /led/*
		rewrite @coupleCatchall /w/{re.couple.slug}{path}
		redir /templates/* https://cdn.aksaraa.com{uri} 302
		redir /fonts/* https://cdn.aksaraa.com{uri} 302
		redir /images/* https://cdn.aksaraa.com{uri} 302
	}

	reverse_proxy 127.0.0.1:3002 {
		header_up X-Real-IP {client_ip}
	}
}

stg.education.aksaraa.com {
	basic_auth {
		aksaraa $2a$14$Pn3LOv9m1brHUI6t1DhP1ODuC1fgH8fXqOs3l26aQ/AONBqEV5tY.
	}
	reverse_proxy 127.0.0.1:3100 {
		header_up X-Real-IP {client_ip}
	}
}

# Old staging hostname: permanent redirect to the canonical one.
staging.aksaraa.com {
	redir https://stg.education.aksaraa.com{uri} permanent
}

# Static asset host for guest invitations. The invitation page stays on the
# couple subdomain (DNS-only, no 2-level cert), while every byte of template art,
# fonts and images is served from here through Cloudflare's edge cache.
cdn.aksaraa.com {
	root * /var/www/aksara-wedding/.next/standalone/public
	# Atlas/Academy art lives in the R2 bucket behind art.aksaraa.com. Art URLs
	# stored in that project's DB are absolute and still point at this host, so
	# keep them working with a 302 (same pattern as /fonts; instant rollback).
	@art path /atlas/* /academy/* /og/*
	redir @art https://art.aksaraa.com{uri} 302
	encode zstd gzip
	header {
		Access-Control-Allow-Origin "*"
		Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	}
	file_server
}
