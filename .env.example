# Environment layout (names only — never put a value in this file)
#
#   .env.development.local   local dev (next dev). Replaces the old .env.local,
#                            which `next build` also loads — that is how staging
#                            credentials reached a prod build.
#   .env.build.<env>         NEXT_PUBLIC_* only. Sourced for `npm run build:env`.
#   .env.runtime.<env>       server secrets. Installed on the host as
#                            /var/www/<app>/.env.production (chmod 600) and read
#                            by PM2 via --env-file. Never sourced for a build.
#   .env.ops                 Cloudflare / Supabase management tokens. Used by ops
#                            scripts only; never sourced for build or deploy.
#
# `npm run build:env -- --env prod|staging` validates the environment against
# env/contract.mjs and refuses unknown NEXT_PUBLIC_* keys, so a leftover
# `source .env.staging` cannot silently reach a prod bundle.

# ---- buildPublic (inlined by Next at build time) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_ENV=
NEXT_PUBLIC_COUPLE_URL_MODE=
NEXT_PUBLIC_WP_ORIGIN=
NEXT_PUBLIC_COUPLE_APEX_DOMAIN=
NEXT_PUBLIC_CS_WIDGET=

# ---- runtime (server only) ----
SUPABASE_SERVICE_ROLE_KEY=
WP_INTERNAL_SECRET=
SCANNER_JWT_SECRET=
AUTH_SESSION_SECRET=
CRON_SECRET=
WA_TARGET_GROUP_JID=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
GUEST_PHOTOS_CLEANUP_TOKEN=
NOTIFY_GROUP_ENABLED=
WP_RECLAIM_ON_BOOT=

# ---- ops (management APIs, never for build/deploy) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCESS_TOKEN=
CLOUDFLARE_ZONE_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
